{
  "name": "elevator-waiting-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "check:js": "node --check legacy/script.js",
    "check:types": "tsc --noEmit --pretty false",
    "build:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File crates/elevator-control-core/scripts/build-wasm.ps1",
    "test:rust": "cargo test",
    "test:wasm": "node crates/elevator-control-core/tests/wasm-contract.mjs",
    "test:unit": "vitest run --config apps/web/vite.config.ts",
    "test": "npm run check:js && npm run check:types && npm run test:unit && npm run test:rust && npm run test:wasm"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
